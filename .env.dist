# Strapi v5 base URL (no trailing /api). GraphQL is served at $STRAPI_URL/graphql.
STRAPI_URL=http://localhost:1337
# Optional: prefix for relative media URLs (defaults to STRAPI_URL). Strapi Cloud returns absolute URLs.
STRAPI_MEDIA_PREFIX=
MEILI_URL=http://localhost:7700
# Search-only Meilisearch key. It is public: never put the master key here.
MEILI_SEARCH_KEY=
# Optional GA4 measurement id (G-XXXXXXX).
GTAG_ID=
